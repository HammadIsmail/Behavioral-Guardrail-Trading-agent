# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ---- Alpaca (paper trading) ----
# Generate a key pair at https://app.alpaca.markets/paper/dashboard/overview
# -> "API Keys" -> Generate. The secret is shown only once.
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here

# Paper trading endpoint. Do not point this at live trading —
# this project places real orders against whatever URL is set here.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market data endpoint. Used to price symbols the account doesn't already
# hold, so the oversized-position rule can size a trade honestly.
ALPACA_DATA_URL=https://data.alpaca.markets

# ---- Groq (plain-language explanations only) ----
# Free key at https://console.groq.com/keys
# Optional: leave blank and the app falls back to deterministic explanations
# built from the rule reasons. The guardrail decision never depends on this.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- App ----
APP_ENV=development
