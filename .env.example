# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ---- Alpaca (paper trading) ----
# Generate a key pair at https://app.alpaca.markets/paper/dashboard/overview
# -> "API Keys" -> Generate. The secret is shown only once.
ALPACA_API_KEY=your_alpaca_paper_key_here
ALPACA_SECRET_KEY=your_alpaca_paper_secret_here

# Paper trading endpoint. The autonomous agent places real market orders
# against whatever URL is set here — pointing it at live trading would
# trade live money. Don't.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market data endpoint. Used for position sizing and for the strategy's
# moving averages.
ALPACA_DATA_URL=https://data.alpaca.markets

# ---- Groq (plain-language explanations only) ----
# Free key at https://console.groq.com/keys
# Optional: leave blank and the app falls back to deterministic explanations
# built from the rule reasons. The guardrail decision never depends on this.
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Journal persistence ----
# The agent runs across days and restarts, so the journal is the P&L record.
#
# Leave DATABASE_URL blank locally — the journal then uses SQLite at
# JOURNAL_DB_PATH and needs no setup.
#
# Set DATABASE_URL when deploying (serverless disks are ephemeral, so a SQLite
# file would be wiped on every cold start). A Neon connection string looks like:
#   postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Prefer Neon's *pooled* host (the one with `-pooler`) for serverless — it
# handles the many short-lived connections that cold starts produce.
DATABASE_URL=
JOURNAL_DB_PATH=journal.db

# ---- Autonomous agent ----
# Set false to run the dashboard without the trading loop.
AGENT_ENABLED=true
# How often the loop wakes. It self-gates on market hours regardless.
AGENT_INTERVAL_SECONDS=900
# Cap on orders placed per cycle, so one pass can't churn the whole book.
AGENT_MAX_TRADES_PER_CYCLE=3
AGENT_UNIVERSE=AAPL,MSFT,NVDA,AMZN,GOOGL,META,TSLA,AMD,NFLX,JPM

# ---- Strategy ----
STRATEGY_SHORT_WINDOW=5
STRATEGY_LONG_WINDOW=20
# Base position size as a fraction of portfolio value.
STRATEGY_BASE_POSITION_PCT=0.08
# Strong signals scale the position up to this multiple of the base. Left
# above the guardrail's 15% ceiling on purpose: that's how conviction
# scaling gets caught instead of silently obeyed.
STRATEGY_MAX_CONVICTION_MULTIPLE=3.0
# Total capital the strategy will put to work, as a fraction of portfolio value.
# 1.0 = no margin. Buying power is ~4x portfolio on a paper account, so without
# this the agent levers itself by accumulation. Keep in step with
# OverexposureRule.MAX_TOTAL_EXPOSURE_PCT, which is the actual authority.
STRATEGY_MAX_TOTAL_EXPOSURE_PCT=1.0

# ---- App ----
APP_ENV=development
